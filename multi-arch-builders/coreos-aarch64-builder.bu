# This butane config will do the following:
#
# - Merge in the builder-common.bu Butane file
# - Allow the builder user to log in with the associated ssh key
# - Set a hostname
#
variant: fcos
version: 1.4.0
ignition:
  config:
    merge:
      - source: https://github.com/coreos/fedora-coreos-pipeline/raw/refs/heads/main/multi-arch-builders/builder-common.bu
passwd:
  users:
    - name: builder
      ssh_authorized_keys:
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAICvSIDZcWWIi7yIEsoXype2MySD+yHMgODJScqPgrH+w builder@fcos-pipeline-aarch64
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAICZf2f4jsdFI0AJ4sUPrZc/fn+QGUdT4VoK3J4k8M7KN builder@rhcos-pipeline-aarch64
storage:
  files:
    - path: /etc/hostname
      mode: 0644
      overwrite: true
      contents:
        inline: coreos-aarch64-builder
