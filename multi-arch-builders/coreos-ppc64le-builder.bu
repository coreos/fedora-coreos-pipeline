# This butane config will do the following:
#
# - Merge in the builder-common.bu Butane file
# - Allow the builder user to log in with the associated ssh key
# - Set a hostname
#
variant: fcos
version: 1.4.0
ignition:
  config:
    merge:
      - source: https://github.com/coreos/fedora-coreos-pipeline/raw/refs/heads/main/multi-arch-builders/builder-common.bu
passwd:
  users:
    - name: builder
      ssh_authorized_keys:
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDZX3VQjF4dfE8ZPMbJ62xv1s45Y48pVGwAQUWWGCY76 builder@fcos-pipeline-ppc64le
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFy7WwuUSf1inqiOlvG22keC94noDrnYh58ObHmVC04l builder@rhcos-pipeline-ppc64le
storage:
  files:
    - path: /etc/hostname
      mode: 0644
      overwrite: true
      contents:
        inline: coreos-ppc64le-builder
