# This butane config will do the following:
#
# - Merge in the builder-common.bu Butane file
# - Allow the builder user to log in with the associated ssh key
# - Set a hostname
#
variant: fcos
version: 1.4.0
ignition:
  config:
    merge:
      - source: https://github.com/coreos/fedora-coreos-pipeline/raw/refs/heads/main/multi-arch-builders/builder-common.bu
passwd:
  users:
    - name: builder
      ssh_authorized_keys:
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAILRQdRiVgjkZRmV2L1ruac+b/B3CX+8KLIc3m+1ebQTR builder@fcos-pipeline-x86_64
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIA2Uy7Y26OK9KVzd/bglYSjZCjyBjtPJHwGFsRMegIzm builder@rhcos-pipeline-x86_64
storage:
  files:
    - path: /etc/hostname
      mode: 0644
      overwrite: true
      contents:
        # no underscore in the hostname
        inline: coreos-x86-64-builder
