# This butane config will do the following:
#
# - Allow designated users to log in as the core user
# - Disable kernel mitigations (not a shared instance)
# - Set up the podman socket for the builder user (podman remote)
# - Build coreos-assembler on the first boot and once a day
# - Configure zincati to allow updates at a specific time (early Monday)
# - Enable linger for builder (so processes can run even if user hasn't
#   logged in)
# - Configure zram
#
variant: fcos
version: 1.4.0
passwd:
  users:
    - name: core
      ssh_authorized_keys:
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIKU/M/tMpknVPKw9owgQViKbXeEEnjpDNMSp35S1BFys c4rt0
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIKn8rBrM5tH7gfvdNr+25/mYSFMqAaeTJd74vP3RT8Ic rolv@fedora
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIK+P37cYfZ9JWGntcBHhry0cwVhCZSBZTPSBivLTdW8s angelcerveraroldan@protonmail.com
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIBJXJfATDWgAQuXXBWpSvUaHw0vvD2eeGd9fsDba9v8V rravanel@redhat.com
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIC32cU/ECfTtp3c5EtAbDnG08XqRFKOm44EwsDuLYYIS tiago.bueno@gmail.com
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIC9Nei11ige8Qa13+qrDbLLRFzTfhvAQUEgUT5p9LwL6 jbtrystram@fedoraproject.org
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMcyjTzxQ3Bso3NBJUQwt1jFr42Orwk6tRc//PqSCckD ydesouza@redhat.com
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHZ9vLZymL1kuiHWkzmacz5de4WmdLmmJ1PlIB6FkAZD marmijo@artemis
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIBA/7FTaJ7y+KA+uyTacExT7fFCJIztazLnjWwoK7yZY afrosi@redhat.com
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAILf3KGyH0x5VIQTD2V5m10TVh1lmhucDY4Gno6yW4QTn bbnaraya@redhat.com
kernel_arguments:
  should_exist:
    - mitigations=off
  should_not_exist:
    - mitigations=auto,nosmt
storage:
  directories:
    - path: /home/builder/.config
      user:
        name: builder
      group:
        name: builder
    - path: /home/builder/.config/systemd
      user:
        name: builder
      group:
        name: builder
    - path: /home/builder/.config/systemd/user
      user:
        name: builder
      group:
        name: builder
    - path: /home/builder/.config/systemd/user/timers.target.wants
      user:
        name: builder
      group:
        name: builder
    - path: /home/builder/.config/systemd/user/sockets.target.wants
      user:
        name: builder
      group:
        name: builder
  files:
    - path: /etc/systemd/zram-generator.conf
      mode: 0644
      contents:
        inline: |
          # This config file enables a /dev/zram0 device with the default settings
          [zram0]
    - path: /etc/zincati/config.d/51-updates-early-monday-morning.toml
      contents:
        inline: |
          [updates]
          strategy = "periodic"
          [[updates.periodic.window]]
          days = [ "Mon" ]
          start_time = "07:00"
          length_minutes = 60
    - path: /var/lib/systemd/linger/builder
      mode: 0644
    - path: /home/builder/.config/systemd/user/prune-container-resources.service
      mode: 0644
      user:
        name: builder
      group:
        name: builder
      contents:
        inline: |
          [Unit]
          Description=Prune Dangling and Expired Container Resources
          [Service]
          Type=oneshot
          ExecStart=/usr/local/bin/prune-container-resources.sh
    - path: /usr/local/bin/prune-container-resources.sh
      mode: 0755
      contents:
        inline: |
          #!/bin/bash
          set -euo pipefail
          podman container prune --force --filter until=1h
          podman volume prune --force --filter="label!=persistent"
          # Remove build containers (e.g. left behind by failed `podman build`
          # runs) older than 24h. These are "external" containers (command
          # "buildah") that `podman container prune` does not see.
          #
          # We don't use `podman image prune --external` for this because its
          # `until` filter is on the image creation date, not the container's.
          # A build that pulls a base image created more than 48h ago (e.g.
          # ubi9/ubi:latest) would get its build container deleted mid-build
          # and fail with "identifier is not a container".
          # Once podman can prune external containers itself, replace this with
          # `podman container prune --external`:
          # https://github.com/podman-container-tools/podman/issues/30030
          podman ps --external --filter until=24h --filter command=buildah --format '{{.ID}}' \
            | xargs --no-run-if-empty podman rm --force \
            || echo "warning: failed to remove old build containers" >&2
          podman image prune --force
          podman image prune --all --force --filter until=48h
    - path: /home/builder/.config/systemd/user/prune-container-resources.timer
      mode: 0644
      user:
        name: builder
      group:
        name: builder
      contents:
        inline: |
            [Timer]
            OnCalendar=*-*-* 10:00:00 UTC
            OnCalendar=*-*-* 22:00:00 UTC
            AccuracySec=30m
            Persistent=true
            [Install]
            WantedBy=timers.target
  links:
    - path: /home/builder/.config/systemd/user/timers.target.wants/prune-container-resources.timer
      target: /home/builder/.config/systemd/user/prune-container-resources.timer
      user:
        name: builder
      group:
        name: builder
    # enable podman socket (used by podman remote) for the user
    - path: /home/builder/.config/systemd/user/sockets.target.wants/podman.socket
      target: /usr/lib/systemd/user/podman.socket
      user:
        name: builder
      group:
        name: builder
